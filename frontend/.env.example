# Copy to .env and fill in real values. Never commit .env itself.

# DeepAR license key — get from https://developer.deepar.ai/
# This key is locked to specific domains (e.g., watch-ar-try-on.vercel.app).
VITE_DEEPAR_LICENSE_KEY=your-deepar-key-here

# Path (relative to the frontend / served root) to the .deepar effect file.
# See SETUP_DEEPAR.md for how to author this file.
VITE_DEEPAR_EFFECT_URL=/effects/chronograph-white.deepar
